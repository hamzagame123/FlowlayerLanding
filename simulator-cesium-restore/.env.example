# Mapbox Standard powers the active simulator map.
VITE_MAPBOX_ACCESS_TOKEN=your-mapbox-public-token

# Google Routes still runs from the browser in this simulator.
# This key must have Routes API enabled and billing attached.
VITE_GOOGLE_MAPS_API_KEY=

# Gemini narration runs server-side through /api/vertex-narrate.
# Override only when testing against a separate local server.
# VITE_GEMINI_NARRATE_ENDPOINT=/api/gemini-narrate

# Server-side only, set in Vercel/local shell. Do not prefix with VITE_.
# The backend also accepts legacy VERTEX_API_KEY, but GEMINI_API_KEY is the intended name.
GEMINI_API_KEY=your-api-key
